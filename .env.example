# Firebird MCP Server environment template
# Copy this file to .env and update values for your environment.

# -----------------------------------------------------------------------------
# Firebird connection
# -----------------------------------------------------------------------------
FIREBIRD_HOST=127.0.0.1
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=
FIREBIRD_USER=SYSDBA
# Required when FIREBIRD_DATABASE is configured.
FIREBIRD_PASSWORD=
FIREBIRD_ROLE=
FIREBIRD_CHARSET=UTF8

# -----------------------------------------------------------------------------
# MCP HTTP transport (optional)
# -----------------------------------------------------------------------------
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
MCP_HTTP_ALLOWED_ORIGINS=
MCP_HTTP_REQUIRE_AUTH=false
MCP_HTTP_AUTH_TOKEN=
MCP_HTTP_ENFORCE_PROTOCOL_VERSION=true
# Max HTTP request body bytes (bounded 1024..10485760).
MCP_HTTP_MAX_BODY_BYTES=1048576

# -----------------------------------------------------------------------------
# MCP operational limits
# Values are clamped internally to safe ranges.
# -----------------------------------------------------------------------------
MCP_TOOL_TIMEOUT_MS=10000
# Per-tool timeout overrides (format: tool1=ms,tool2=ms).
# Example: ping=5000,execute_query=30000
MCP_TOOL_TIMEOUT_OVERRIDES=
MCP_LIST_TABLES_MAX_ITEMS=500
MCP_SCHEMA_MAX_TABLES=200
MCP_SCHEMA_MAX_COLUMNS_PER_TABLE=300
MCP_EXECUTE_QUERY_MAX_ROWS=200
MCP_EXECUTE_QUERY_MAX_PARAMS=50
# SQL policy mode for execute_query: safe (default) or ad-hoc (explicit opt-in).
MCP_EXECUTE_QUERY_MODE=safe
# Comma-separated allowlist for {{identifier}} SQL template substitutions.
# Example: USERS,ORDERS,PUBLIC.USERS
MCP_EXECUTE_QUERY_ALLOWED_IDENTIFIERS=
# Optional path to external tools config file (.json, .yaml, .yml).
MCP_TOOLS_CONFIG_PATH=
# Optional built-in toolset profile: readonly, schema, ops.
MCP_TOOLSET=
# Enable tools/reload RPC to refresh tool registry without restarting the process.
MCP_TOOLS_RELOAD_ENABLED=false
# Explicit Firebird version family override for capability detection.
# Accepted values: 2.5, 3.x, 4.x, 5.x
MCP_FIREBIRD_VERSION_FAMILY_OVERRIDE=

# -----------------------------------------------------------------------------
# Telemetry
# -----------------------------------------------------------------------------
# Enable telemetry counters and spans emission.
MCP_TELEMETRY_ENABLED=false
# Telemetry exporter: logs or none.
MCP_TELEMETRY_EXPORTER=logs
# Maximum in-memory span records retained.
MCP_TELEMETRY_MAX_STORED_SPANS=200
# Optional static profile for client/editor segmentation (example: vscode, cursor, claude).
MCP_TELEMETRY_CLIENT_PROFILE=

# -----------------------------------------------------------------------------
# Security notes
# -----------------------------------------------------------------------------
# 1) Never commit real credentials.
# 2) Prefer a least-privilege read-only Firebird user.
# 3) Use environment-specific files outside version control.