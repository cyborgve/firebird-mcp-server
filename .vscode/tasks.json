{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build MCP Firebird",
      "type": "shell",
      "command": "pnpm run build",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Run MCP Firebird",
      "type": "shell",
      "command": "pnpm run start",
      "group": "test",
      "dependsOn": ["Build MCP Firebird"]
    },
    {
      "label": "Test MCP Firebird",
      "type": "shell",
      "command": "pnpm run test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "MCP API Example (REST Client)",
      "type": "shell",
      "command": "code examples/mcp-firebird-api.http",
      "group": "test"
    }
  ]
}
